// apps/api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserStatus {
  ACTIVE
  ON_HOLD
  SUSPENDED
  PENDING_ONBOARDING
}

enum StakeholderType {
  EMPLOYEE
  CLIENT
  VENDOR
  PARTNER
}

enum ResetRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuthActivityType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  RESET_REQUESTED
  RESET_APPROVED
  PASSWORD_CHANGED
  USER_CREATED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HR_ADMIN
  VERTICAL_HEAD
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  TERMINATED
}

enum EmployeeRole {
  MANAGING_DIRECTOR
  COO
  MANAGEMENT_ADMIN
  VERTICAL_HEAD
  EXECUTIVE
}

enum JobType {
  PERMANENT
  TEMPORARY
  CONTRACT
}

enum QualificationLevel {
  NONE
  TENTH
  TWELFTH
  UG_DEGREE
  PG_DEGREE
}

enum PreviousOrgDocStatus {
  BOTH
  ONE
  NONE
}

enum EmployeeBackground {
  EXPERIENCED
  FRESHER
  FREELANCER
  ENTREPRENEUR
}

enum ChangeRequestStatus {
  PENDING_REVIEW
  QUERY_SENT
  APPROVED
  REJECTED
  CANCELLED
}

// FR-18 / BR-16: requests on an HR employee's own record go to the MD
enum ChangeRequestApprover {
  HR
  MD
}

enum StoredFileStatus {
  PENDING
  ATTACHED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum ClientType {
  INDIVIDUAL
  CORPORATE
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  BLACKLISTED
}

// ==========================================
// 1. AUTHENTICATION MODULE MODELS
// ==========================================

model User {
  id                   String                 @id @default(uuid())
  identifier           String                 @unique // Employee Code e.g. "LL-7K2Q9"
  stakeholderType      StakeholderType        @default(EMPLOYEE)
  role                 UserRole               @default(EMPLOYEE)
  permissions          String[]               @default([])
  passwordHash         String
  status               UserStatus             @default(PENDING_ONBOARDING)
  mustChangePassword   Boolean                @default(false)
  
  failedLoginAttempts  Int                    @default(0)
  lockedUntil          DateTime?
  
  lastLoginAt          DateTime?
  lastPasswordChangeAt DateTime?

  passwordHistories     PasswordHistory[]
  resetRequests         PasswordResetRequest[] @relation("UserResetRequests")
  actionedResetRequests PasswordResetRequest[] @relation("AdminActionedResets")
  activityLogs          AuthActivityLog[]
  auditLogs             AuditLog[]
  uploadedFiles         StoredFile[]
  employee              Employee?

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@map("users")
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_histories")
}

model PasswordResetRequest {
  id           String             @id @default(uuid())
  identifier   String
  userId       String?
  reason       String
  status       ResetRequestStatus @default(PENDING)
  
  actionedById String?
  actionNote   String?
  tempPassword String?

  requestedAt  DateTime           @default(now())
  actionedAt   DateTime?

  user         User?              @relation("UserResetRequests", fields: [userId], references: [id])
  actionedBy   User?              @relation("AdminActionedResets", fields: [actionedById], references: [id])

  @@index([identifier, status])
  @@map("password_reset_requests")
}

model AuthActivityLog {
  id         String           @id @default(uuid())
  userId     String?
  identifier String
  action     AuthActivityType
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime         @default(now())

  user       User?            @relation(fields: [userId], references: [id])

  @@index([identifier])
  @@index([createdAt])
  @@map("auth_activity_logs")
}

model OutboxEvent {
  id            String    @id @default(uuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  processed     Boolean   @default(false)
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([processed, createdAt])
  @@map("outbox_events")
}

// ==========================================
// 2. CORE EMPLOYEE MODULE MODELS
// ==========================================

model Employee {
  id                   String                        @id @default(uuid())
  userId               String                        @unique
  employeeId           String                        @unique // "LL-XXXXX" immutable system key
  firstName            String                        // Sensitivity: Internal
  lastName             String                        // Sensitivity: Internal
  employmentStatus     EmploymentStatus              @default(ACTIVE) // Internal
  
  onboardingCompletedAt DateTime?
  statusChangedOn      DateTime?
  createdById          String?                       // User ID of the HR user who created the record (8.7 #2)
  lastUpdatedById      String?                       // User ID of the last person to change the record (8.7 #5)

  // Relations
  user                 User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalDetail       EmployeePersonalDetail?
  communicationDetail  EmployeeCommunicationDetail?
  emergencyContacts    EmergencyContact[]
  documentDetail       EmployeeDocument?
  educationalDocuments EducationalDocument[]
  employmentDetail     EmployeeEmploymentDetail?
  probationDetail      EmployeeProbationDetail?
  financialDetail      EmployeeFinancialDetail?
  
  // History & Audit Relations
  transferHistories    VerticalTransferHistory[]
  promotionHistories   PromotionHistory[]
  payRevisionHistories PayRevisionHistory[]
  appraisalHistories   AppraisalHistory[]
  changeRequests       EmployeeChangeRequest[]
  
  // Reporting Line Relations
  subordinates         EmployeeEmploymentDetail[]    @relation("ReportingLine")

  // Client Relations
  acquiredClients      Client[]                      @relation("ClientAcquiredBy")
  managedClients       Client[]                      @relation("ClientPrimaryRM")

  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@map("employees")
}

// 8.1 Personal Identity
model EmployeePersonalDetail {
  id            String    @id @default(uuid())
  employeeId    String    @unique
  dateOfBirth   DateTime  // Sensitivity: Confidential
  gender        String    // Sensitivity: Confidential
  bloodGroup    String    // Sensitivity: Confidential
  maritalStatus String    // Sensitivity: Confidential
  fatherName    String    // Sensitivity: Confidential

  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("employee_personal_details")
}

// 8.2 Communication Details
model EmployeeCommunicationDetail {
  id               String   @id @default(uuid())
  employeeId       String   @unique
  personalPhone    String   // Sensitivity: Confidential
  secondaryPhone   String?  // Sensitivity: Confidential
  officialPhone    String   // Sensitivity: Internal
  personalEmail    String   // Sensitivity: Confidential
  officialEmail    String   // Sensitivity: Internal
  currentAddress   String   // Sensitivity: Confidential
  permanentAddress String   // Sensitivity: Confidential

  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("employee_communication_details")
}

model EmergencyContact {
  id           String   @id @default(uuid())
  employeeId   String
  name         String   // Sensitivity: Confidential
  relationship String   // Sensitivity: Confidential
  phone        String   // Sensitivity: Confidential
  isPrimary    Boolean  @default(false)

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId])
  @@map("emergency_contacts")
}

// 8.3 Documentation
model EmployeeDocument {
  id                     String                @id @default(uuid())
  employeeId             String                @unique
  aadhaarNumber          String                // Sensitivity: Restricted
  aadhaarFrontUrl        String?               // Sensitivity: Restricted
  aadhaarBackUrl         String?               // Sensitivity: Restricted
  panNumber              String?               // Sensitivity: Restricted
  panFrontUrl            String?               // Sensitivity: Restricted
  drivingLicenceNumber   String                // Sensitivity: Restricted
  drivingLicenceFrontUrl String?               // Sensitivity: Restricted
  drivingLicenceBackUrl  String?               // Sensitivity: Restricted
  highestQualification   QualificationLevel    // Sensitivity: Confidential
  previousOrgDocStatus   PreviousOrgDocStatus? // Sensitivity: Confidential
  relievingExperienceUrl String?               // Sensitivity: Confidential
  salarySlipUrl          String?               // Sensitivity: Confidential
  secondDocDueDate       DateTime?             // 2 weeks to 1 month due date (BR-05)
  isIncompleteFlag       Boolean               @default(false)
  employeeBackground     EmployeeBackground?   // EXPERIENCED | FRESHER | FREELANCER | ENTREPRENEUR
  recordOfIncomeUrl      String?               // Sensitivity: Confidential

  employee               Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@map("employee_documents")
}

model EducationalDocument {
  id                 String             @id @default(uuid())
  employeeId         String
  qualificationLevel QualificationLevel // 10TH, 12TH, UG_DEGREE, PG_DEGREE
  frontImageUrl      String             // Sensitivity: Confidential
  backImageUrl       String             // Sensitivity: Confidential

  employee           Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([employeeId])
  @@map("educational_documents")
}

// 8.4 Employment Details
model EmployeeEmploymentDetail {
  id                   String       @id @default(uuid())
  employeeId           String       @unique
  vertical             String       // 10 Business Verticals / 5 Functional Verticals (Internal)
  role                 EmployeeRole // MD, COO, Vertical Head, Executive (Internal)
  jobType              JobType      // Permanent, Temporary, Contract (Internal)
  joiningDate          DateTime     // Sensitivity: Internal
  reportingAuthorityId String?      // FK to Employee (Reporting Manager)
  exitDate             DateTime?    // Sensitivity: Internal
  exitReason           String?      // Sensitivity: Confidential

  employee             Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reportingAuthority   Employee?    @relation("ReportingLine", fields: [reportingAuthorityId], references: [id])

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("employee_employment_details")
}

model EmployeeProbationDetail {
  id                 String   @id @default(uuid())
  employeeId         String   @unique
  probationPeriod    String   // Probation duration (Confidential)
  financialAgreement String   // Financial terms during probation (Confidential)

  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("employee_probation_details")
}

// 8.5 Financial Details
model EmployeeFinancialDetail {
  id                   String    @id @default(uuid())
  employeeId           String    @unique
  accountNumber        String    // Sensitivity: Restricted
  accountHolderName    String    // Sensitivity: Restricted
  ifscCode             String    // Sensitivity: Restricted
  branchName           String    // Sensitivity: Restricted
  takeHomePayTotal     Decimal   // Sensitivity: Restricted
  cashComponent        Decimal?  // Sensitivity: Restricted
  bankComponent        Decimal?  // Sensitivity: Restricted
  nextAppraisalWindow  DateTime  // Sensitivity: Restricted

  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("employee_financial_details")
}

// Career History Logs
model VerticalTransferHistory {
  id            String   @id @default(uuid())
  employeeId    String
  fromVertical  String
  toVertical    String
  transferredAt DateTime @default(now())

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("vertical_transfer_histories")
}

model PromotionHistory {
  id           String       @id @default(uuid())
  employeeId   String
  fromRole     EmployeeRole
  toRole       EmployeeRole
  promotedAt   DateTime     @default(now())

  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("promotion_histories")
}

model PayRevisionHistory {
  id            String   @id @default(uuid())
  employeeId    String
  previousPay   Decimal
  newPay        Decimal
  effectiveDate DateTime

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("pay_revision_histories")
}

model AppraisalHistory {
  id              String   @id @default(uuid())
  employeeId      String
  appraisalWindow String
  outcome         String
  reviewedAt      DateTime @default(now())

  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("appraisal_histories")
}

// ==========================================
// 3. CHANGE REQUEST ENGINE
// ==========================================

model EmployeeChangeRequest {
  id                   String                @id @default(uuid())
  employeeId           String
  requestedById        String                // User ID of the employee (FR-16: own record only)
  routedTo             ChangeRequestApprover
  status               ChangeRequestStatus   @default(PENDING_REVIEW)
  queryReason          String?
  rejectionReason      String?
  reviewDueDate        DateTime              // 24-hour review window (FR-22)
  employeeReplyDueDate DateTime?             // 24-hour reply window after a query (FR-22)
  submittedAt          DateTime              @default(now())
  resolvedAt           DateTime?
  resolvedById         String?               // User ID of the approver / rejecter

  employee             Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedFields      ChangeRequestField[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([employeeId, status])
  @@index([routedTo, status])
  @@map("employee_change_requests")
}

model ChangeRequestField {
  id            String                @id @default(uuid())
  requestId     String
  fieldKey      String                // Key from the employee field catalogue
  currentValue  Json?                 // Value when the request was raised (stale-approval check)
  proposedValue Json
  proofFileKey  String?               // FR-17: proof attachment where the field requires it
  isQueried     Boolean               @default(false) // FR-19: field named in HR's query

  changeRequest EmployeeChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, fieldKey])
  @@map("change_request_fields")
}

// ==========================================
// 3. CLIENT MODULE MODELS
// ==========================================

model Client {
  id           String       @id @default(uuid())
  clientCode   String       @unique // CL-XXXXX
  clientType   ClientType   @default(INDIVIDUAL)
  status       ClientStatus @default(ACTIVE)

  acquiredById String
  primaryRMId  String?

  acquiredBy   Employee     @relation("ClientAcquiredBy", fields: [acquiredById], references: [id])
  primaryRM    Employee?    @relation("ClientPrimaryRM", fields: [primaryRMId], references: [id])

  profile      ClientProfile?
  contact      ClientContact?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([clientCode])
  @@index([acquiredById])
  @@index([primaryRMId])
  @@index([status])
  @@map("clients")
}

model ClientProfile {
  id            String   @id @default(uuid())
  clientId      String   @unique

  firstName     String?
  lastName      String?
  companyName   String?
  panNumber     String?
  aadhaarNumber String?
  gstNumber     String?

  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("client_profiles")
}

model ClientContact {
  id               String   @id @default(uuid())
  clientId         String   @unique

  primaryPhone     String
  secondaryPhone   String?
  email            String?
  currentAddress   String?
  permanentAddress String?

  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("client_contacts")
}

// ==========================================
// 4. AUDIT MODULE MODELS
// ==========================================

// Single append-only business audit trail shared by all modules (see docs/adr/centralized-audit-log.md).
// Auth/security events stay in auth_activity_logs.
model AuditLog {
  id          String         @id @default(uuid())
  occurredAt  DateTime       @default(now())
  actorType   AuditActorType
  actorUserId String?
  action      String         // e.g. "employee.direct_edit", "client.primary_rm.reassigned"
  entityType  String         // EMPLOYEE | CLIENT | ...
  entityId    String
  reason      String?
  changes     Json?          // [{ field, old, new }]
  metadata    Json?

  actor       User?          @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action])
  @@map("audit_logs")
}

// ==========================================
// 5. FILES MODULE MODELS
// ==========================================

// One row per uploaded file (BRD 8.7 #13: uploaded on / uploaded by)
model StoredFile {
  id           String           @id @default(uuid())
  key          String           @unique // Storage key, e.g. "employee-documents/<uuid>.jpg"
  fileName     String
  mimeType     String
  size         Int
  sha256       String
  status       StoredFileStatus @default(PENDING)
  uploadedById String
  uploadedAt   DateTime         @default(now())
  attachedAt   DateTime?

  uploadedBy   User             @relation(fields: [uploadedById], references: [id])

  @@index([status, uploadedAt])
  @@map("stored_files")
}
