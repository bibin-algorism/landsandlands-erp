meta {
  name: Update Client
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/clients/{{clientId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "primaryPhone": "+919845099999",
