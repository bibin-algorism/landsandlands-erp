meta {
  name: Change Password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "TempPassword123!",
    "newPassword": "NewStrongPassword2026!"
  }
}
