meta {
  name: Create User
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/admin/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

