meta {
  name: Admin Action Reset
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/admin/reset-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "requestId": "REPLACE_WITH_PENDING_REQUEST_ID",
    "action": "APPROVED",
    "note": "Identity verified via HR phone check."
  }
}
