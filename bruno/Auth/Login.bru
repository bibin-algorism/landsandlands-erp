meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identifier": "LL_1002",
    "password": "$KR2ggtT9d"
  }
}

script:post-response {
  if (res.body.accessToken) {
    bru.setEnvVar("token", res.body.accessToken);
  }
  if (res.body.tempToken) {
    bru.setEnvVar("tempToken", res.body.tempToken);
  }
}
