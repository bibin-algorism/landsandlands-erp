meta {
  name: Direct Edit Employee
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/api/v1/employees/{{employeeId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "expectedUpdatedAt": "<system.updatedAt from Get Employee by ID>",
    "reason": "Moved to Secondary with revised pay",
    "changes": {
      "communication.officialPhone": "9000000001",
      "employment.vertical": "Secondary",
      "financial.takeHomePay": {
        "takeHomePayTotal": 35000,
        "bankComponent": 33000,
        "cashComponent": 2000,
        "effectiveDate": "2026-11-01"
      }
    }
  }
}
