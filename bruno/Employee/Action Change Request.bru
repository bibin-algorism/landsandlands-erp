meta {
  name: Action Change Request
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/employees/change-requests/{{changeRequestId}}/action
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "action": "APPROVE",
    "reason": "Address proof document verified by HR Admin"
  }
}
