meta {
  name: Create Employee (Model 1 Onboarding)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/employees
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

