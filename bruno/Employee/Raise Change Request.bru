meta {
  name: Raise Change Request
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/employees/me/change-requests
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "fields": [
      {
        "fieldKey": "communication.personalEmail",
        "proposedValue": "new.email@gmail.com"
      },
      {
        "fieldKey": "communication.currentAddress",
        "proposedValue": "14, Race Course Road, Coimbatore 641018",
        "proofFileKey": "<key from Upload Employee Document>"
      }
    ]
  }
}
