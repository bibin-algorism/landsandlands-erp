meta {
  name: Reject Change Request
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/v1/employees/change-requests/{{changeRequestId}}/reject
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reason": "Proof does not match the new address"
  }
}
